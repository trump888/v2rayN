<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <!-- =============================================================== -->
  <!-- NET48 PORT                                                       -->
  <!--                                                               -->
  <!-- Almost every package upstream uses now ships a net4x or        -->
  <!-- netstandard2.0 asset, so the net48 port tracks upstream's     -->
  <!-- versions exactly. That is the whole point: matching upstream   -->
  <!-- versions means upstream source compiles unmodified. Each pin    -->
  <!-- was verified against the published package layout (lib/ +      -->
  <!-- ref/) for that exact version.                                  -->
  <!--                                                               -->
  <!-- A net48 project binds a net481 asset (a later 4.x TFM          -->
  <!-- satisfies an earlier one). That is what lets us use             -->
  <!-- ReactiveUI 24.3.0 and so keep upstream's                       -->
  <!-- ReactiveUI.Primitives (Signal<T>, RxVoid) and its               -->
  <!-- [Reactive] partial-property source generators working          -->
  <!-- as-is, instead of back-porting them to ReactiveUI 19.x.        -->
  <!--                                                               -->
  <!-- See README.md for the full matrix and rationale.               -->
  <!-- =============================================================== -->

  <!-- OVERRIDES (deviate from upstream on purpose):
       Downloader                     5.9.8 -> 3.1.2
         3.2.0 dropped lib/net462 and lib/netstandard2.0 and ships
         lib/net8.0 only, which net48 cannot bind. 3.1.2 is the last
         release with a net48-consumable asset. Three 5.x members are
         absent there and are handled in scripts/patch-targeted.ps1
         (see MaxTryAgainOnFailure / MinimumChunkSize /
         CustomHttpMessageHandlerFactory).

       TUnit / TUnit.Assertions.Should -> not shipped
         ServiceLib.Tests is not part of the net48 ship: the upstream
         TUnit runner requires .NET 8+. The port leaves
         ServiceLib.Tests untouched and simply does not reference it
         from the solution, so upstream test changes never rot it.

       Repobot.SQLite.Unofficial     -> keep upstream version
         Native-only package (runtimes/ assets, no managed lib/), so
         it has no TFM constraint. BUT see the RuntimeIdentifier note
         in patches/Directory.Build.props: its win-x64 native
         (e_sqlite3.dll) is only copied to the output when a RID is
         set, and without it the app dies at startup with
         DllNotFoundException.
  -->

  <ItemGroup>
    <!-- Test stack: kept only so `dotnet restore` on the full solution
         succeeds if ServiceLib.Tests is ever re-enabled. TUnit itself
         requires net8+, so it cannot run on net48. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="AwesomeAssertions" Version="6.12.0" />
    <PackageVersion Include="xunit.v3" Version="1.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!-- Library stack: identical versions to upstream unless noted. -->
    <PackageVersion Include="CliWrap" Version="3.10.5" />
    <PackageVersion Include="Downloader" Version="3.1.2" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageVersion Include="IPNetwork2" Version="4.3.0" />
    <PackageVersion Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageVersion Include="NLog" Version="6.2.1" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion Include="ReactiveUI" Version="24.3.0" />
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="3.2.0" />
    <PackageVersion Include="ReactiveUI.WPF" Version="24.2.0" />
    <PackageVersion Include="sqlite-net-e" Version="1.11.285" />
    <PackageVersion Include="Repobot.SQLite.Unofficial" Version="3.53.4.1" />
    <PackageVersion Include="TaskScheduler" Version="2.12.2" />
    <PackageVersion Include="WebDav.Client" Version="2.9.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.22" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

  <!-- =============================================================== -->
  <!-- net48 BCL surface polyfills.                                     -->
  <!-- These provide the .NET 6/8/9/10 APIs that upstream calls into     -->
  <!-- (Span/Memory, async file IO, JSON, Channels, IAsyncEnumerable).  -->
  <!-- Every one of these ships a net462 or netstandard2.0 asset.      -->
  <!-- =============================================================== -->
  <ItemGroup>
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <!-- 10.0.11, not 8.0.0: ReactiveUI.WPF 24.2.0 -> ReactiveUI.Primitives.Wpf
         ReactiveUI.Primitives 8.2.0 requires System.Threading.Channels >= 10.0.12, and central pinning
         below that trips NU1109 (detected package downgrade). Upstream does not
         pin this package at all; it arrives transitively. 10.0.11 ships
         lib/net462 + lib/netstandard2.0, so net48 can still bind it. -->
    <PackageVersion Include="System.Threading.Channels" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <!-- 4.6.2 (not 4.6.1): ReactiveUI 24.3.0 declares a transitive
         System.ValueTuple >= 4.6.2, and central pinning below that trips
         NU1109 "detected package downgrade". -->
    <PackageVersion Include="System.ValueTuple" Version="4.6.2" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
    <!-- Reference assemblies so net48 can also be built off-Windows
         (Linux/macOS CI, and the local verify-local.sh loop). -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>
</Project>