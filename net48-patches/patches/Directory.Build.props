<Project>

    <PropertyGroup>
        <Version>7.24.4-net48</Version>
    </PropertyGroup>

    <!-- =========================================================== -->
    <!-- NET48 PORT: changed from net10.0 -> net48                    -->
    <!-- C# language version pinned to 9.0 (the highest that works    -->
    <!-- reliably on net48 SDK-style projects).                       -->
    <!--                                                              -->
    <!-- Records / init-setters / nullable annotations still work     -->
    <!-- via the IsExternalInit shim in ServiceLib/Common/.           -->
    <!-- =========================================================== -->
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <!-- C# 13 + preview features. Preview is required for two things the
             port depends on:
               - null-conditional assignment (obj?.field = value), C# 14 preview
               - extension *properties*, which is how upstream's
                 `span.IsEmpty` (no parentheses) binds to our shim
             Partial properties come from ReactiveUI.SourceGenerators. -->
        <LangVersion>preview</LangVersion>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <Nullable>annotations</Nullable>

        <!-- ======================================================= -->
        <!-- NET48 PORT: RuntimeIdentifier is REQUIRED, not cosmetic. -->
        <!-- ======================================================= -->
        <!-- SqliteHelper's constructor opens the DB on the very first
             CreateTable call, which App.OnStartup does before the main
             window is shown. The managed provider
             (SQLitePCLRaw.provider.e_sqlite3.dll) P/Invokes into the
             native e_sqlite3.dll, which comes from
             Repobot.SQLite.Unofficial's runtimes/<rid>/native/ assets.
             That package has NO buildTransitive targets to copy the
             native, and for a .NET Framework build the SDK only copies
             runtimes/ assets into the output when a RuntimeIdentifier is
             set. Without it the publish output has no e_sqlite3.dll and
             the app throws DllNotFoundException at startup; because
             App.xaml.cs swallows DispatcherUnhandledException and
             ShutdownMode is OnExplicitShutdown, the symptom is a
             running process with no window.
             AppendRuntimeIdentifierToOutputPath=false keeps the output
             at bin/<cfg>/net48/ so CI paths do not change. -->
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

        <!-- Original v2rayN uses `<ImplicitUsings>enable</ImplicitUsings>` in    -->
        <!-- net10. Their GlobalUsings.cs files only add a few extras on top of -->
        <!-- the SDK-default implicit usings (System, System.Collections.Generic, -->
        <!-- System.Threading.Tasks, System.IO, System.Linq, etc.). On net48 we  -->
        <!-- must keep this enabled so the same source files compile unmodified. -->
        <ImplicitUsings>enable</ImplicitUsings>
        <Authors>2dust (net48 port)</Authors>
        <PackageLicenseExpression>GPL-3.0</PackageLicenseExpression>
        <Copyright>Copyright © 2017-$([System.DateTime]::UtcNow.Year)</Copyright>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <!-- ======================================================= -->
    <!-- NET48 PORT: trim SkiaSharp native payload.              -->
    <!--                                                        -->
    <!-- ZXing.Net.Bindings.SkiaSharp (the QR generator) drags  -->
    <!-- in SkiaSharp, which fans out to two native packages    -->
    <!-- that between them put 137 MB of dead weight in the     -->
    <!-- output for an x64 Windows build that needs 11 MB:      -->
    <!--                                                        -->
    <!--   libSkiaSharp.pdb        80.1 MB  runtimes/win-x64/   -->
    <!--                                    native/, debug-only -->
    <!--   libSkiaSharp.dylib      14.5 MB  macOS, from the    -->
    <!--                                    macOS package's      -->
    <!--                                    buildTransitive     -->
    <!--                                    targets, which copy -->
    <!--                                    unconditionally     -->
    <!--                                    and ignore the RID -->
    <!--   x86/ + arm64/ copies    19.6 MB  other              -->
    <!--                                    architectures       -->
    <!--                                                        -->
    <!-- ShouldIncludeNativeSkiaSharp=False is the opt-out     -->
    <!-- both native packages expose. It removes the arch       -->
    <!-- subdirectories and the dylib. The Windows native still -->
    <!-- lands in the output root, because it arrives through   -->
    <!-- the SDK's own RID asset resolution (NativeCopyLocalItems)-->
    <!-- not through those packages' targets, so turning this    -->
    <!-- off does not lose libSkiaSharp.dll.                     -->
    <!--                                                        -->
    <!-- Measured on a clean net48 ServiceLib build:             -->
    <!--   before  137.14 MB of SkiaSharp files                  -->
    <!--   after    11.83 MB (libSkiaSharp.dll + 2 managed)      -->
    <!--                                                        -->
    <!-- The second target drops native .pdb files from the     -->
    <!-- copy list. Every file under runtimes/<rid>/native/ is  -->
    <!-- treated as a native runtime asset, and libSkiaSharp.pdb -->
<!-- sits right next to libSkiaSharp.dll, so it is copied   -->
    <!-- whether or not it is wanted. DebugType=embedded below  -->
    <!-- makes shipping symbols pointless even for the managed   -->
    <!-- assemblies: symbols are a build-time aid, and this one  -->
    <!-- costs 80 MB and buys nothing at runtime.                -->
    <!-- ======================================================= -->
    <PropertyGroup>
        <ShouldIncludeNativeSkiaSharp>False</ShouldIncludeNativeSkiaSharp>
    </PropertyGroup>

    <Target Name="_net48TrimNativeDebugSymbols" AfterTargets="ResolvePackageAssets">
        <ItemGroup>
            <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
        </ItemGroup>
    </Target>

    <!-- Linux/macOS need this package to provide net48 reference assemblies -->
    <!-- (System.Threading.Tasks, System.IO, System.Collections.Generic etc.) -->
    <!-- On Windows + VS 2022 with .NET Framework 4.8 Dev Pack installed, this -->
    <!-- is redundant but harmless.                                            -->
    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
        <!-- System.Buffers is needed by ServiceLib.UdpTest's GlobalUsings.cs   -->
        <!-- (uses System.Buffers.Binary). On net48 it's a separate facade DLL, -->
        <!-- so we add it globally to cover all subprojects.                    -->
        <PackageReference Include="System.Buffers" />
        <!-- System.Memory provides Span<T> / ReadOnlySpan<T> on net48.         -->
        <PackageReference Include="System.Memory" />
        <!-- System.Net.Http provides HttpClient/HttpClientHandler on net48     -->
        <!-- (the System.Net.Http.dll that ships with net48 lacks newer APIs).  -->
        <PackageReference Include="System.Net.Http" />
    </ItemGroup>

    <!-- net48 does NOT support single-file publish / ready-to-run the same -->
    <!-- way net8+ does. Strip the net10-specific Release properties.        -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>embedded</DebugType>
        <EventSourceSupport>false</EventSourceSupport>
        <StackTraceSupport>false</StackTraceSupport>
        <MetricsSupport>false</MetricsSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
        <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
    </PropertyGroup>
</Project>
