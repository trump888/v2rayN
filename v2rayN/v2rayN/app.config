<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pairs with app.manifest. Declaring PerMonitorV2 in the manifest is only half
    of it: that stops Windows bitmap-stretching the window, but .NET Framework
    WinForms does not rescale anything by itself, so the result is a sharp UI at
    the wrong size: every control drawn at 1/1.5 or 1/2 scale on a scaled
    display.

    This switch is what makes WinForms actually apply the scale. Together they are
    exactly what Visual Studio's "Per Monitor V2" project setting generates.

    The two must agree. If you remove the DPI block from app.manifest, remove
    this too, or the UI comes back tiny on any display that is not at 100%.
  -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
