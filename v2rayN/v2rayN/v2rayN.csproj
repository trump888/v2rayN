<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- The CI-only SingboxConfigCheck project exercises ShareHandler,
         V2rayConfigHandler and Global, which are all internal. Grant it access
         rather than widening the shipped public API to make them testable.
         An item, so it belongs in an ItemGroup: MSBuild rejects it inside a
         PropertyGroup with MSB4066. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>SingboxConfigCheck</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <PropertyGroup>
    <!--
      NU1902: log4net < 3.3.0 is flagged (GHSA-4f7c-pmjv-c25w, medium: silent log
      event loss in XmlLayout / XmlLayoutSchemaLog4J from unescaped XML 1.0
      forbidden characters).

      Not applicable to this app, and deliberately suppressed rather than left as
      unexplained noise: Tool/Logging.cs configures a PatternLayout
      ("%date [%thread] %-5level %logger - %message%newline") and never
      instantiates XmlLayout or XmlLayoutSchemaLog4J, which are the only affected
      code paths.

      This does NOT resolve the advisory. The whole 2.x line is affected and the
      fix is 3.3.0+, which is a major version with breaking API changes
      (reworked LoggingEvent and target setup) and needs runtime testing this
      branch's CI cannot do. If log4net is ever moved to 3.x, delete this
      suppression.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-4f7c-pmjv-c25w" />
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>preview</LangVersion>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Copyright>Copyright © 2019-2022 (GPLv3)</Copyright>
    <FileVersion>5.39</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>v2rayN.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Sample\custom_routing_black" />
    <None Remove="Sample\custom_routing_global" />
    <None Remove="Sample\custom_routing_locked" />
    <None Remove="Sample\custom_routing_rules" />
    <None Remove="Sample\custom_routing_white" />
    <None Remove="Sample\SampleClientConfig.txt" />
    <None Remove="Sample\SampleHttprequest.txt" />
    <None Remove="Sample\SampleHttpresponse.txt" />
    <None Remove="Sample\SampleInbound.txt" />
    <None Remove="Sample\SampleServerConfig.txt" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Sample\custom_routing_black" />
    <EmbeddedResource Include="Sample\custom_routing_global" />
    <EmbeddedResource Include="Sample\custom_routing_locked" />
    <EmbeddedResource Include="Sample\custom_routing_rules" />
    <EmbeddedResource Include="Sample\custom_routing_white" />
    <EmbeddedResource Include="Sample\SampleClientConfig.txt" />
    <EmbeddedResource Include="Sample\SampleHttprequest.txt" />
    <EmbeddedResource Include="Sample\SampleHttpresponse.txt" />
    <EmbeddedResource Include="Sample\SampleInbound.txt" />
    <EmbeddedResource Include="Sample\SampleServerConfig.txt" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Data.Linq" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Messaging" />
    <Reference Include="System.Net" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Net.Http.WebRequest" />
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\Statistics.proto" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf">
      <Version>3.21.5</Version>
    </PackageReference>
    <PackageReference Include="Grpc.Core">
      <Version>2.46.3</Version>
    </PackageReference>
    <PackageReference Include="Grpc.Tools">
      <Version>2.47.0</Version>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="log4net">
      <Version>2.0.17</Version>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json">
      <Version>13.0.4</Version>
    </PackageReference>
    <PackageReference Include="NHotkey">
      <Version>2.1.1</Version>
    </PackageReference>
    <PackageReference Include="NHotkey.WindowsForms">
      <Version>2.1.1</Version>
    </PackageReference>
    <PackageReference Include="ZXing.Net">
      <Version>0.16.11</Version>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <PostBuildEvent>del $(TargetDir)*.xml $(TargetDir)*.so $(TargetDir)*.dylib
if not "$(ConfigurationName)" == "Debug" del $(TargetDir)*.pdb</PostBuildEvent>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
</Project>